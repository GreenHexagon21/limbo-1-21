execute in limbo:limbo_dim at @e[type=mannequin, name="Shaman"] as @e[type=mannequin, name="Shaman"] run tp @s @e[distance=..30, type=villager, name="Solitary Shaman", limit=1, sort=nearest]
execute in limbo:limbo_dim at @a if entity @e[distance=..30, type=villager, name="Solitary Shaman"] run attribute @e[distance=..30, type=villager, limit=1,sort=nearest, name="Solitary Shaman"] scale base set 1.2 
execute in limbo:limbo_dim at @a if entity @e[distance=..30, type=villager, name="Solitary Shaman"] run effect give @e[distance=..30, type=villager, limit=1,sort=nearest, name="Solitary Shaman"] invisibility infinite 1 true
execute in limbo:limbo_dim at @e[type=mannequin, name="Shaman"] as @e[type=mannequin, name="Shaman"] unless entity @e[distance=..30, type=villager, name="Solitary Shaman"] run kill @s
