execute in limbo:limbo_dim at @a if entity @e[distance=..30, type=villager, name="Hermit Herbalist"] at @e[distance=..30, type=villager, name="Hermit Herbalist"] unless entity @e[type=mannequin, name="Herbalist", distance=..30, limit=1] run summon mannequin ~ ~ ~ {NoGravity:1b,Invulnerable:1b,CustomNameVisible:0b,hide_description:true,CustomName:"Herbalist"}
execute in limbo:limbo_dim at @e[type=mannequin, name="Herbalist"] as @e[type=mannequin, name="Herbalist"] run tp @s @e[distance=..30, type=villager, name="Hermit Herbalist", limit=1, sort=nearest]
execute in limbo:limbo_dim at @a if entity @e[distance=..30, type=villager, name="Hermit Herbalist"] run attribute @e[distance=..30, type=villager, limit=1,sort=random, name="Hermit Herbalist"] scale base set 1.2 
execute in limbo:limbo_dim at @a if entity @e[distance=..30, type=villager, name="Hermit Herbalist"] run effect give @e[distance=..30, type=villager, limit=1,sort=random, name="Hermit Herbalist"] invisibility infinite 1 true
execute in limbo:limbo_dim at @e[type=mannequin, name="Herbalist"] as @e[type=mannequin, name="Herbalist"] unless entity @e[distance=..30, type=villager, name="Hermit Herbalist"] run kill @s
execute in limbo:limbo_dim as @e[type=mannequin, name="Herbalist"] at @e[type=mannequin, name="Herbalist"] if block ~ ~ ~ minecraft:black_bed run data modify entity @e[type=mannequin, name="Herbalist", limit=1, sort=nearest] pose set value "sleeping"
execute in limbo:limbo_dim as @e[type=mannequin, name="Herbalist"] at @e[type=mannequin, name="Herbalist"] unless block ~ ~ ~ minecraft:black_bed run data modify entity @e[type=mannequin, name="Herbalist", limit=1, sort=nearest] pose set value "standing"